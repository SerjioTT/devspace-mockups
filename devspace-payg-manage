<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>DevSpace — Управление пространством (PayG)</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
  :root {
    --accent: #12B0A0;
    --accent-hover: #0E9484;
    --accent-pressed: #0B7F72;
    --accent-soft: #E6F6F4;
    --text: #3F3F46;
    --text-secondary: #71717A;
    --border: #D0D1D3;
    --line: #E4E4E7;
    --bg-alt: #F7F9FB;
    --white: #FFFFFF;
    --dark: #152949;
    --bg-app: #FAFAFA;
    --success: #58CB24;
    --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: var(--font); background: var(--bg-app); color: var(--text);
    font-size: 12px; line-height: 20px;
    -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
  }
  .app { display: grid; grid-template-columns: 238px 1fr; min-height: 100vh; }

  /* Sidebar */
  .sidebar { background: #FFF; border-right: 1px solid var(--line); padding: 20px 12px; display: flex; flex-direction: column; gap: 4px; }
  .brand { font-weight: 500; font-size: 15px; padding: 4px 12px 16px; display: flex; align-items: center; gap: 8px; }
  .brand-dot { width: 24px; height: 24px; background: var(--accent); border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; color: #fff; font-size: 13px; font-weight: 600; }
  .nav-item { padding: 8px 12px; display: flex; align-items: center; gap: 10px; color: var(--text-secondary); border-radius: 6px; cursor: pointer; font-size: 12px; }
  .nav-item:hover { background: var(--bg-alt); color: var(--text); }
  .nav-item.active { background: var(--accent-soft); color: var(--accent-pressed); }
  .nav-section-label { font-size: 11px; font-weight: 500; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; padding: 16px 12px 8px; }

  /* Header */
  .main { display: flex; flex-direction: column; min-width: 0; }
  .header { height: 48px; background: #FFF; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; padding: 0 24px; }
  .header-title { font-size: 12px; color: var(--text-secondary); }
  .header-right { display: flex; align-items: center; gap: 12px; }
  .header-icon { width: 32px; height: 32px; border-radius: 50%; background: var(--bg-alt); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; color: var(--text-secondary); }
  .avatar { width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #12B0A0, #0E9484); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-weight: 600; font-size: 12px; }

  /* Content */
  .content { padding: 24px; width: 100%; }
  .breadcrumbs { color: var(--text-secondary); font-size: 12px; line-height: 16px; margin-bottom: 16px; display: flex; align-items: center; gap: 6px; }
  .breadcrumbs a { color: var(--text-secondary); text-decoration: none; }
  .breadcrumbs a:hover { color: var(--text); }
  .breadcrumbs .sep { color: var(--border); }
  .breadcrumbs .current { color: var(--text); }

  .layout { display: flex; }

  /* ---------- Left: management form ---------- */
  .manage { width: 512px; flex-shrink: 0; display: flex; flex-direction: column; }
  .h1 { font-weight: 500; font-size: 26px; line-height: 34px; margin: 0; padding-bottom: 16px; color: var(--text); }

  .table-row { display: flex; align-items: center; padding: 12px 0; border-bottom: 0.5px solid var(--border); }
  .table-label { width: 156px; padding-right: 16px; flex-shrink: 0; font-size: 12px; color: var(--text); }
  .table-value { flex: 1; padding: 0 16px; font-size: 12px; color: var(--text); display: flex; align-items: center; gap: 8px; }
  .table-value.multiline { line-height: 20px; }
  .table-edit { width: 32px; display: inline-flex; align-items: center; justify-content: center; color: var(--text-secondary); cursor: pointer; flex-shrink: 0; }
  .table-edit:hover { color: var(--accent); }
  .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); flex-shrink: 0; }

  /* ---------- Limits section ---------- */
  .limits-header { display: flex; align-items: center; gap: 8px; padding: 20px 0 4px; }
  .limits-title { font-size: 16px; line-height: 24px; font-weight: 500; margin: 0; color: var(--text); }

  .slider-block { display: flex; flex-direction: column; padding: 8px 0; }
  .slider-label { font-size: 12px; line-height: 20px; color: var(--text); margin-bottom: 2px; font-weight: 500; }
  .slider-row { display: flex; gap: 32px; align-items: flex-start; }
  .slider-track-wrap { flex: 1; min-width: 0; padding-top: 4px; }
  input[type="range"] {
    -webkit-appearance: none; appearance: none; width: 100%; height: 4px;
    background: linear-gradient(to right, var(--accent) 0%, var(--accent) var(--fill, 50%), var(--line) var(--fill, 50%), var(--line) 100%);
    border-radius: 2px; outline: none; margin: 4px 0 0; cursor: pointer;
  }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none; width: 12px; height: 12px;
    border-radius: 50%; background: var(--accent); cursor: pointer;
    border: none; box-shadow: 0 1px 2px rgba(0,0,0,0.2);
  }
  input[type="range"]::-moz-range-thumb {
    width: 12px; height: 12px; border-radius: 50%; background: var(--accent);
    cursor: pointer; border: none; box-shadow: 0 1px 2px rgba(0,0,0,0.2);
  }
  .slider-minmax { display: flex; justify-content: space-between; font-size: 12px; line-height: 16px; color: var(--text-secondary); margin-top: 4px; }

  .slider-value { display: flex; align-items: center; gap: 8px; width: 131px; flex-shrink: 0; }
  .slider-input {
    width: 78px; height: 36px; padding: 8px 16px; border: 1px solid var(--line);
    background: var(--white); font-family: inherit; font-size: 12px; line-height: 20px;
    color: var(--text); text-align: left;
  }
  .slider-input:focus { outline: none; border-color: var(--accent); }
  .slider-unit { font-size: 12px; color: var(--text); display: flex; align-items: center; gap: 2px; white-space: nowrap; }

  /* Buttons */
  .actions { display: flex; align-items: center; justify-content: space-between; padding-top: 24px; margin-top: 16px; border-top: 1px solid var(--line); }
  .btn {
    height: 36px; width: 175px; border-radius: 24px; font-family: inherit;
    font-size: 14px; line-height: 20px; font-weight: 600; cursor: pointer;
    border: 1px solid transparent; display: inline-flex; align-items: center; justify-content: center;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .btn-secondary { background: var(--white); color: var(--text); border-color: var(--line); }
  .btn-secondary:hover { background: var(--bg-alt); }
  .btn-apply { background: var(--bg-alt); color: var(--border); cursor: not-allowed; }
  .btn-apply.enabled { background: var(--accent); color: var(--white); cursor: pointer; }
  .btn-apply.enabled:hover { background: var(--accent-hover); }

  /* ---------- Budget block (итог под слайдерами) ---------- */
  .budget-block {
    background: var(--bg-alt);
    border-radius: 8px;
    padding: 16px 20px;
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .budget-block-header { display: flex; align-items: center; gap: 8px; }
  .budget-block-title { font-size: 12px; line-height: 20px; color: var(--text); font-weight: 500; }
  .budget-block-sum {
    font-size: 26px; line-height: 34px; font-weight: 500; color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .budget-block-sum .unit { font-size: 16px; font-weight: 400; color: var(--text-secondary); }
  .budget-link-row { display: flex; align-items: center; gap: 6px; margin-top: 4px; }
  .budget-link-row a { color: var(--text-secondary); text-decoration: underline; text-underline-offset: 2px; font-size: 12px; cursor: pointer; }
  .budget-link-row a:hover { color: var(--accent); }

  /* Info icon + tooltip */
  .info-icon { display: inline-flex; align-items: center; justify-content: center; color: var(--text-secondary); cursor: help; position: relative; flex-shrink: 0; }
  .info-icon:hover { color: var(--accent); }
  .tooltip {
    position: absolute; z-index: 30; background: var(--dark); color: #F9FAFB;
    padding: 10px 12px; border-radius: 6px; font-size: 12px; line-height: 16px;
    width: 240px; box-shadow: 0 12px 24px rgba(16,24,40,0.15);
    opacity: 0; visibility: hidden; transition: opacity 0.15s, transform 0.15s; font-weight: 400;
  }
  .tooltip.show { opacity: 1; visibility: visible; }
  .tooltip.top { bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%) translateY(-4px); }
  .tooltip.top.show { transform: translateX(-50%) translateY(0); }
  .tooltip.top::after { content: ''; position: absolute; top: 100%; left: 50%; transform: translateX(-50%); border: 5px solid transparent; border-top-color: var(--dark); }
  .tooltip strong { color: #fff; }
  .tooltip.narrow { width: 160px; }

  /* Responsive */
  @media (max-width: 1100px) {
    .layout { flex-direction: column; }
  }
  @media (max-width: 720px) {
    .app { grid-template-columns: 1fr; }
    .sidebar { display: none; }
    .content { padding: 16px; }
    .manage { width: 100%; }
  }

  .demo-hint {
    position: fixed; bottom: 16px; right: 16px; background: var(--dark); color: #F9FAFB;
    padding: 10px 14px; border-radius: 6px; font-size: 12px; line-height: 16px;
    box-shadow: 0 12px 24px rgba(16,24,40,0.15); max-width: 280px; z-index: 100;
  }
  .demo-hint b { color: #6CE9DA; }
  .demo-hint-close { display: inline-block; margin-left: 8px; cursor: pointer; color: #98A2B3; }
  .demo-hint-close:hover { color: #fff; }
</style>
</head>
