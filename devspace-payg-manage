                <svg width="16" height="16" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7.5" stroke="currentColor" stroke-width="1.5"/><circle cx="10" cy="6.75" r="0.9" fill="currentColor"/><rect x="9.25" y="9" width="1.5" height="5" rx="0.75" fill="currentColor"/></svg>
                <span id="budget-tip" class="tooltip top">Максимальная сумма, которую могут стоить ресурсы вашего пространства. Работает как страховка: нагрузки технически не смогут занять ресурсов больше, чем на установленную сумму.</span>
              </span>
            </div>
            <div class="budget-block-sum">до <span id="budget-total">358 456</span> <span class="unit">₸ в месяц</span></div>
            <div class="budget-link-row">
              <svg width="14" height="14" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7.5" stroke="#71717A" stroke-width="1.5"/><circle cx="10" cy="6.75" r="0.9" fill="#71717A"/><rect x="9.25" y="9" width="1.5" height="5" rx="0.75" fill="#71717A"/></svg>
              <a href="https://s5-oblakoteka.teamly.ru/at/33ceed60-9edc-41ed-98ab-8bf9ec55018e" target="_blank" rel="noopener noreferrer" onclick="event.preventDefault(); window.open(this.href, '_blank', 'noopener,noreferrer');">Как рассчитывается стоимость</a>
            </div>
          </div>

          <div class="actions">
            <button class="btn btn-secondary" onclick="resetAll()">Отмена</button>
            <button class="btn btn-apply" id="apply-btn" disabled>Применить</button>
          </div>
        </section>

      </div>
    </div>
  </div>
</div>

<div class="demo-hint" id="demo-hint">
  <b>Демо-макет PayG.</b> Управление пространством: двигайте <b>слайдеры</b> — бюджет пересчитается. Наведите на <b>ⓘ</b> у CPU.
  <span class="demo-hint-close" onclick="document.getElementById('demo-hint').style.display='none'">✕</span>
</div>

<script>
  // ===== Pricing model (per month, no discount) =====
  const PRICE = { guar: 14190, pool: 2400, ram: 1100, storage: 300, ip: 3500 };
  const GUAR_RATIO = 10;   // CPU limit / 10 = guaranteed vCPU

  const DEFAULTS = { cpu: 64, ram: 64, storage: 150, ip: 4 };

  const els = {
    cpu:    { range: document.getElementById('cpu-range'),    input: document.getElementById('cpu-input') },
    ram:    { range: document.getElementById('ram-range'),    input: document.getElementById('ram-input') },
    storage:{ range: document.getElementById('storage-range'),input: document.getElementById('storage-input') },
    ip:     { range: document.getElementById('ip-range'),     input: document.getElementById('ip-input') },
  };

  function fmtInt(v) {
    return Math.round(v).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '\u00A0');
  }
  function fmtSmart(v) {
    let f;
    if (v < 10) f = v.toFixed(2);
    else if (v < 100) f = v.toFixed(1);
    else f = Math.round(v).toString();
    const [i, d] = f.split('.');
    const ii = i.replace(/\B(?=(\d{3})+(?!\d))/g, '\u00A0');
    return d ? ii + ',' + d : ii;
  }
  function fmtQty(v) {
    // up to 1 decimal, comma
    const f = (Math.round(v * 10) / 10).toString();
    return f.replace('.', ',');
  }

  function getVals() {
    return {
      cpu: parseInt(els.cpu.input.value) || 0,
      ram: parseInt(els.ram.input.value) || 0,
      storage: parseInt(els.storage.input.value) || 0,
      ip: parseInt(els.ip.input.value) || 0,
    };
  }

  function updateFill(range) {
    const min = parseFloat(range.min), max = parseFloat(range.max), val = parseFloat(range.value);
    const pct = ((val - min) / (max - min)) * 100;
    range.style.setProperty('--fill', pct + '%');
  }

  function recalc() {
    const v = getVals();
    const guar = v.cpu / GUAR_RATIO;
    const pool = v.cpu - guar;
    const f = 1; // месяц — единственный период лимита

    const sumPool = pool * PRICE.pool * f;
    const sumGuar = guar * PRICE.guar * f;
    const sumRam = v.ram * PRICE.ram * f;
    const sumStorage = v.storage * PRICE.storage * f;
    const sumIp = v.ip * PRICE.ip * f;
    const total = sumPool + sumGuar + sumRam + sumStorage + sumIp;

    document.getElementById('budget-total').textContent = fmtSmart(total);
    document.getElementById('cpu-guar-value').textContent = fmtQty(guar);

    // Enable/disable apply button
    const changed = v.cpu !== DEFAULTS.cpu || v.ram !== DEFAULTS.ram || v.storage !== DEFAULTS.storage || v.ip !== DEFAULTS.ip;
    const btn = document.getElementById('apply-btn');
    btn.classList.toggle('enabled', changed);
    btn.disabled = !changed;
  }

  // Bind sliders <-> inputs
  Object.values(els).forEach(({ range, input }) => {
    updateFill(range);
    range.addEventListener('input', () => {
      input.value = range.value;
      updateFill(range);
      recalc();
    });
    input.addEventListener('input', () => {
      let val = parseInt(input.value);
      if (isNaN(val)) return;
      val = Math.max(parseInt(range.min), Math.min(parseInt(range.max), val));
      range.value = val;
      updateFill(range);
      recalc();
    });
    input.addEventListener('blur', () => {
      let val = parseInt(input.value);
      if (isNaN(val)) val = parseInt(range.min);
      val = Math.max(parseInt(range.min), Math.min(parseInt(range.max), val));
      input.value = val;
      range.value = val;
      updateFill(range);
      recalc();
    });
  });

  function resetAll() {
    els.cpu.range.value = els.cpu.input.value = DEFAULTS.cpu;
    els.ram.range.value = els.ram.input.value = DEFAULTS.ram;
    els.storage.range.value = els.storage.input.value = DEFAULTS.storage;
    els.ip.range.value = els.ip.input.value = DEFAULTS.ip;
    Object.values(els).forEach(({ range }) => updateFill(range));
    recalc();
  }

  // Tooltips
  document.querySelectorAll('[data-tooltip]').forEach(anchor => {
    const tooltip = document.getElementById(anchor.getAttribute('data-tooltip'));
    if (!tooltip) return;
    let hideTimer;
    const show = () => { clearTimeout(hideTimer); tooltip.classList.add('show'); };
    const hide = () => { hideTimer = setTimeout(() => tooltip.classList.remove('show'), 100); };
    anchor.addEventListener('mouseenter', show);
    anchor.addEventListener('mouseleave', hide);
    tooltip.addEventListener('mouseenter', show);
    tooltip.addEventListener('mouseleave', hide);
  });

  recalc();
</script>

</body>
